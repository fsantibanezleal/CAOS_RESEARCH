ring r0 = 0,(x,y,z),wp(1,1,2);
matrix D[3][3];
D[1,2] = -z;
def S = nc_algebra(1,D);
setring S;
module M = [(8753)*z^1+(17125)*y^2+(3664)*x^1*y^1+(23309)*x^2,(21909)*z^1+(11077)*y^2+(3735)*x^1*y^1+(1358)*x^2],[(14920)*z^1+(14968)*y^2+(14026)*x^1*y^1+(21160)*x^2,(2338)*z^1+(12412)*y^2+(6345)*x^1*y^1+(30962)*x^2],[(14848)*z^1+(18741)*y^2+(5787)*x^1*y^1+(13015)*x^2,(26576)*z^1+(31007)*y^2+(23690)*x^1*y^1+(20884)*x^2];
intvec sh0 = 0,0;
proc vdeg(vector v, intvec sh)
{
  int i; intvec e;
  for (i = 1; i <= size(sh); i++)
  {
    if (v[i] != 0)
    {
      e = leadexp(v[i]);
      return(e[1] + e[2] + 2*e[3] + sh[i]);
    }
  }
  return(-1000000);
}
list L = mres(M, 0);
int i, j, n, t;
intvec sh = sh0;
intvec nsh;
print("DEG 0 " + string(sh0));
for (i = 1; i <= size(L); i++)
{
  n = 0;
  for (j = 1; j <= ncols(L[i]); j++) { if (L[i][j] != 0) { n++; } }
  if (n == 0) { print("DEG " + string(i)); break; }
  nsh = 0:n;
  t = 0;
  for (j = 1; j <= ncols(L[i]); j++)
  {
    if (L[i][j] != 0) { t++; nsh[t] = vdeg(L[i][j], sh); }
  }
  print("DEG " + string(i) + " " + string(nsh));
  sh = nsh;
}
print("END");
quit;
