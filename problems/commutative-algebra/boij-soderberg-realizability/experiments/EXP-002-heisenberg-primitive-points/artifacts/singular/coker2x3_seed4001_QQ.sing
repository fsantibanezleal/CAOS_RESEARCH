ring r0 = 0,(x,y,z),wp(1,1,2);
matrix D[3][3];
D[1,2] = -z;
def S = nc_algebra(1,D);
setring S;
module M = [(13967)*z^1+(13611)*y^2+(21764)*x^1*y^1+(4501)*x^2,(16358)*z^1+(6345)*y^2+(16094)*x^1*y^1+(25235)*x^2],[(26541)*z^1+(22850)*y^2+(28150)*x^1*y^1+(24379)*x^2,(30850)*z^1+(27813)*y^2+(24846)*x^1*y^1+(15396)*x^2],[(25326)*z^1+(21549)*y^2+(18949)*x^1*y^1+(25997)*x^2,(16529)*z^1+(7972)*y^2+(25162)*x^1*y^1+(10763)*x^2];
intvec sh0 = 0,0;
proc vdeg(vector v, intvec sh)
{
  int i; intvec e;
  for (i = 1; i <= size(sh); i++)
  {
    if (v[i] != 0)
    {
      e = leadexp(v[i]);
      return(e[1] + e[2] + 2*e[3] + sh[i]);
    }
  }
  return(-1000000);
}
list L = mres(M, 0);
int i, j, n, t;
intvec sh = sh0;
intvec nsh;
print("DEG 0 " + string(sh0));
for (i = 1; i <= size(L); i++)
{
  n = 0;
  for (j = 1; j <= ncols(L[i]); j++) { if (L[i][j] != 0) { n++; } }
  if (n == 0) { print("DEG " + string(i)); break; }
  nsh = 0:n;
  t = 0;
  for (j = 1; j <= ncols(L[i]); j++)
  {
    if (L[i][j] != 0) { t++; nsh[t] = vdeg(L[i][j], sh); }
  }
  print("DEG " + string(i) + " " + string(nsh));
  sh = nsh;
}
print("END");
quit;
