ring r0 = 0,(x,y,z),wp(1,1,2);
matrix D[3][3];
D[1,2] = -z;
def S = nc_algebra(1,D);
setring S;
module M = [(8525)*z^1+(24292)*y^2+(4221)*x^1*y^1+(28308)*x^2,(30772)*z^1+(16772)*y^2+(9870)*x^1*y^1+(20651)*x^2],[(26328)*z^1+(22507)*y^2+(31659)*x^1*y^1+(26428)*x^2,(24741)*z^1+(31639)*y^2+(619)*x^1*y^1+(14258)*x^2],[(19808)*z^1+(12616)*y^2+(28389)*x^1*y^1+(5501)*x^2,(17444)*z^1+(14354)*y^2+(7200)*x^1*y^1+(26582)*x^2];
intvec sh0 = 0,0;
proc vdeg(vector v, intvec sh)
{
  int i; intvec e;
  for (i = 1; i <= size(sh); i++)
  {
    if (v[i] != 0)
    {
      e = leadexp(v[i]);
      return(e[1] + e[2] + 2*e[3] + sh[i]);
    }
  }
  return(-1000000);
}
list L = mres(M, 0);
int i, j, n, t;
intvec sh = sh0;
intvec nsh;
print("DEG 0 " + string(sh0));
for (i = 1; i <= size(L); i++)
{
  n = 0;
  for (j = 1; j <= ncols(L[i]); j++) { if (L[i][j] != 0) { n++; } }
  if (n == 0) { print("DEG " + string(i)); break; }
  nsh = 0:n;
  t = 0;
  for (j = 1; j <= ncols(L[i]); j++)
  {
    if (L[i][j] != 0) { t++; nsh[t] = vdeg(L[i][j], sh); }
  }
  print("DEG " + string(i) + " " + string(nsh));
  sh = nsh;
}
print("END");
quit;
