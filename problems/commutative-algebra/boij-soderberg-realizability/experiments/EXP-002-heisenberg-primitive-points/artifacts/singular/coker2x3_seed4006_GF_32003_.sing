ring r0 = 32003,(x,y,z),wp(1,1,2);
matrix D[3][3];
D[1,2] = -z;
def S = nc_algebra(1,D);
setring S;
module M = [(22465)*z^1+(16436)*y^2+(7389)*x^1*y^1+(26450)*x^2,(22287)*z^1+(11126)*y^2+(26358)*x^1*y^1+(4115)*x^2],[(885)*z^1+(2986)*y^2+(21783)*x^1*y^1+(19947)*x^2,(4465)*z^1+(27780)*y^2+(27993)*x^1*y^1+(13367)*x^2],[(30446)*z^1+(11178)*y^2+(15965)*x^1*y^1+(21800)*x^2,(19922)*z^1+(14614)*y^2+(22333)*x^1*y^1+(24866)*x^2];
intvec sh0 = 0,0;
proc vdeg(vector v, intvec sh)
{
  int i; intvec e;
  for (i = 1; i <= size(sh); i++)
  {
    if (v[i] != 0)
    {
      e = leadexp(v[i]);
      return(e[1] + e[2] + 2*e[3] + sh[i]);
    }
  }
  return(-1000000);
}
list L = mres(M, 0);
int i, j, n, t;
intvec sh = sh0;
intvec nsh;
print("DEG 0 " + string(sh0));
for (i = 1; i <= size(L); i++)
{
  n = 0;
  for (j = 1; j <= ncols(L[i]); j++) { if (L[i][j] != 0) { n++; } }
  if (n == 0) { print("DEG " + string(i)); break; }
  nsh = 0:n;
  t = 0;
  for (j = 1; j <= ncols(L[i]); j++)
  {
    if (L[i][j] != 0) { t++; nsh[t] = vdeg(L[i][j], sh); }
  }
  print("DEG " + string(i) + " " + string(nsh));
  sh = nsh;
}
print("END");
quit;
