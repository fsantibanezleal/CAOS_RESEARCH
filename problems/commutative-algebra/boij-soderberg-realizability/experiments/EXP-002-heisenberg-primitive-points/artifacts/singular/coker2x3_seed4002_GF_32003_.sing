ring r0 = 32003,(x,y,z),wp(1,1,2);
matrix D[3][3];
D[1,2] = -z;
def S = nc_algebra(1,D);
setring S;
module M = [(13834)*z^1+(29826)*y^2+(21067)*x^1*y^1+(22718)*x^2,(2855)*z^1+(28871)*y^2+(15309)*x^1*y^1+(26472)*x^2],[(19228)*z^1+(837)*y^2+(7700)*x^1*y^1+(24720)*x^2,(23801)*z^1+(24429)*y^2+(1484)*x^1*y^1+(2089)*x^2],[(24862)*z^1+(9307)*y^2+(19889)*x^1*y^1+(15794)*x^2,(9558)*z^1+(1418)*y^2+(31430)*x^1*y^1+(17569)*x^2];
intvec sh0 = 0,0;
proc vdeg(vector v, intvec sh)
{
  int i; intvec e;
  for (i = 1; i <= size(sh); i++)
  {
    if (v[i] != 0)
    {
      e = leadexp(v[i]);
      return(e[1] + e[2] + 2*e[3] + sh[i]);
    }
  }
  return(-1000000);
}
list L = mres(M, 0);
int i, j, n, t;
intvec sh = sh0;
intvec nsh;
print("DEG 0 " + string(sh0));
for (i = 1; i <= size(L); i++)
{
  n = 0;
  for (j = 1; j <= ncols(L[i]); j++) { if (L[i][j] != 0) { n++; } }
  if (n == 0) { print("DEG " + string(i)); break; }
  nsh = 0:n;
  t = 0;
  for (j = 1; j <= ncols(L[i]); j++)
  {
    if (L[i][j] != 0) { t++; nsh[t] = vdeg(L[i][j], sh); }
  }
  print("DEG " + string(i) + " " + string(nsh));
  sh = nsh;
}
print("END");
quit;
