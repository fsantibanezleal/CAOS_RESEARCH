ring r0 = 32003,(x,y,z),wp(1,1,2);
matrix D[3][3];
D[1,2] = -z;
def S = nc_algebra(1,D);
setring S;
module M = [(19124)*z^1+(29070)*y^2+(22288)*x^1*y^1+(19619)*x^2,(7212)*y^2+(1)*x^1*y^1],[(24968)*z^1+(22614)*y^2+(12508)*x^1*y^1+(9078)*x^2,(5834)*y^2+(1)*x^2],[(11341)*z^1+(4381)*y^2+(24719)*x^1*y^1+(24030)*x^2,(1)*z^1+(2028)*y^2];
intvec sh0 = -8,-8;
proc vdeg(vector v, intvec sh)
{
  int i; intvec e;
  for (i = 1; i <= size(sh); i++)
  {
    if (v[i] != 0)
    {
      e = leadexp(v[i]);
      return(e[1] + e[2] + 2*e[3] + sh[i]);
    }
  }
  return(-1000000);
}
list L = mres(M, 0);
int i, j, n, t;
intvec sh = sh0;
intvec nsh;
print("DEG 0 " + string(sh0));
for (i = 1; i <= size(L); i++)
{
  n = 0;
  for (j = 1; j <= ncols(L[i]); j++) { if (L[i][j] != 0) { n++; } }
  if (n == 0) { print("DEG " + string(i)); break; }
  nsh = 0:n;
  t = 0;
  for (j = 1; j <= ncols(L[i]); j++)
  {
    if (L[i][j] != 0) { t++; nsh[t] = vdeg(L[i][j], sh); }
  }
  print("DEG " + string(i) + " " + string(nsh));
  sh = nsh;
}
print("END");
quit;
