ring r0 = 32003,(x,y,z),wp(1,1,2);
matrix D[3][3];
D[1,2] = -z;
def S = nc_algebra(1,D);
setring S;
module M = [(16379)*z^1+(15585)*y^2+(22636)*x^1*y^1+(11631)*x^2,(1754)*z^1+(16725)*y^2+(29300)*x^1*y^1+(25674)*x^2],[(31235)*z^1+(13098)*y^2+(919)*x^1*y^1+(14682)*x^2,(19699)*z^1+(49)*y^2+(12401)*x^1*y^1+(21717)*x^2],[(13288)*z^1+(24482)*y^2+(7139)*x^1*y^1+(8158)*x^2,(11004)*z^1+(22805)*y^2+(6950)*x^1*y^1+(20085)*x^2];
intvec sh0 = 0,0;
proc vdeg(vector v, intvec sh)
{
  int i; intvec e;
  for (i = 1; i <= size(sh); i++)
  {
    if (v[i] != 0)
    {
      e = leadexp(v[i]);
      return(e[1] + e[2] + 2*e[3] + sh[i]);
    }
  }
  return(-1000000);
}
list L = mres(M, 0);
int i, j, n, t;
intvec sh = sh0;
intvec nsh;
print("DEG 0 " + string(sh0));
for (i = 1; i <= size(L); i++)
{
  n = 0;
  for (j = 1; j <= ncols(L[i]); j++) { if (L[i][j] != 0) { n++; } }
  if (n == 0) { print("DEG " + string(i)); break; }
  nsh = 0:n;
  t = 0;
  for (j = 1; j <= ncols(L[i]); j++)
  {
    if (L[i][j] != 0) { t++; nsh[t] = vdeg(L[i][j], sh); }
  }
  print("DEG " + string(i) + " " + string(nsh));
  sh = nsh;
}
print("END");
quit;
