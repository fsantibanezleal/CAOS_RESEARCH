ring r0 = 32003,(x,y,z),wp(1,1,2);
matrix D[3][3];
D[1,2] = -z;
def S = nc_algebra(1,D);
setring S;
module M = [(31308)*y^1*z^1+(18292)*y^3+(10175)*x^1*z^1+(8864)*x^1*y^2+(13940)*x^2*y^1+(15991)*x^3,(21254)*y^1*z^1+(25203)*y^3+(12634)*x^1*z^1+(20989)*x^1*y^2+(10840)*x^2*y^1+(16033)*x^3],[(28037)*y^1*z^1+(9827)*y^3+(27023)*x^1*z^1+(6132)*x^1*y^2+(507)*x^2*y^1+(16903)*x^3,(8982)*y^1*z^1+(27909)*y^3+(11421)*x^1*z^1+(13314)*x^1*y^2+(17657)*x^2*y^1+(22101)*x^3],[(14221)*y^1*z^1+(7758)*y^3+(16496)*x^1*z^1+(1706)*x^1*y^2+(7696)*x^2*y^1+(8536)*x^3,(19783)*y^1*z^1+(28225)*y^3+(4554)*x^1*z^1+(19522)*x^1*y^2+(18795)*x^2*y^1+(16119)*x^3];
intvec sh0 = 0,0;
proc vdeg(vector v, intvec sh)
{
  int i; intvec e;
  for (i = 1; i <= size(sh); i++)
  {
    if (v[i] != 0)
    {
      e = leadexp(v[i]);
      return(e[1] + e[2] + 2*e[3] + sh[i]);
    }
  }
  return(-1000000);
}
list L = mres(M, 0);
int i, j, n, t;
intvec sh = sh0;
intvec nsh;
print("DEG 0 " + string(sh0));
for (i = 1; i <= size(L); i++)
{
  n = 0;
  for (j = 1; j <= ncols(L[i]); j++) { if (L[i][j] != 0) { n++; } }
  if (n == 0) { print("DEG " + string(i)); break; }
  nsh = 0:n;
  t = 0;
  for (j = 1; j <= ncols(L[i]); j++)
  {
    if (L[i][j] != 0) { t++; nsh[t] = vdeg(L[i][j], sh); }
  }
  print("DEG " + string(i) + " " + string(nsh));
  sh = nsh;
}
print("END");
quit;
