ring r0 = 32003,(x,y,z),wp(1,1,2);
matrix D[3][3];
D[1,2] = -z;
def S = nc_algebra(1,D);
setring S;
module M = [(14325)*y^1+(3404)*x^1,(6812)*y^1+(9516)*x^1,(22131)*y^1+(29423)*x^1,(30942)*y^1+(2425)*x^1],[(2512)*y^1+(4014)*x^1,(27644)*y^1+(12960)*x^1,(16346)*y^1+(2986)*x^1,(14199)*y^1+(14406)*x^1],[(11303)*y^1+(6164)*x^1,(17295)*y^1+(30003)*x^1,(21328)*y^1+(2277)*x^1,(28885)*y^1+(13055)*x^1],[(26529)*y^1+(11142)*x^1,(12601)*y^1+(11555)*x^1,(31637)*y^1+(25350)*x^1,(19989)*y^1+(27676)*x^1],[(10425)*y^1+(10659)*x^1,(8937)*y^1+(16212)*x^1,(18196)*y^1+(60)*x^1,(17426)*y^1+(21174)*x^1];
intvec sh0 = 0,0,0,0;
proc vdeg(vector v, intvec sh)
{
  int i; intvec e;
  for (i = 1; i <= size(sh); i++)
  {
    if (v[i] != 0)
    {
      e = leadexp(v[i]);
      return(e[1] + e[2] + 2*e[3] + sh[i]);
    }
  }
  return(-1000000);
}
list L = mres(M, 0);
int i, j, n, t;
intvec sh = sh0;
intvec nsh;
print("DEG 0 " + string(sh0));
for (i = 1; i <= size(L); i++)
{
  n = 0;
  for (j = 1; j <= ncols(L[i]); j++) { if (L[i][j] != 0) { n++; } }
  if (n == 0) { print("DEG " + string(i)); break; }
  nsh = 0:n;
  t = 0;
  for (j = 1; j <= ncols(L[i]); j++)
  {
    if (L[i][j] != 0) { t++; nsh[t] = vdeg(L[i][j], sh); }
  }
  print("DEG " + string(i) + " " + string(nsh));
  sh = nsh;
}
print("END");
quit;
