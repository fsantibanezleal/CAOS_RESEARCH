ring r0 = 32003,(x,y,z),wp(1,1,2);
matrix D[3][3];
D[1,2] = -z;
def S = nc_algebra(1,D);
setring S;
module M = [(9933)*y^1+(31684)*x^1,(1631)*y^1+(18871)*x^1,(7749)*y^1+(18101)*x^1],[(6939)*y^1+(6229)*x^1,(13059)*y^1+(19335)*x^1,(15439)*y^1+(8865)*x^1],[(15797)*y^1+(26478)*x^1,(5280)*y^1+(24554)*x^1,(2605)*y^1+(22025)*x^1],[(12527)*y^1+(2314)*x^1,(27782)*y^1+(9952)*x^1,(1993)*y^1+(9404)*x^1];
intvec sh0 = 0,0,0;
proc vdeg(vector v, intvec sh)
{
  int i; intvec e;
  for (i = 1; i <= size(sh); i++)
  {
    if (v[i] != 0)
    {
      e = leadexp(v[i]);
      return(e[1] + e[2] + 2*e[3] + sh[i]);
    }
  }
  return(-1000000);
}
list L = mres(M, 0);
int i, j, n, t;
intvec sh = sh0;
intvec nsh;
print("DEG 0 " + string(sh0));
for (i = 1; i <= size(L); i++)
{
  n = 0;
  for (j = 1; j <= ncols(L[i]); j++) { if (L[i][j] != 0) { n++; } }
  if (n == 0) { print("DEG " + string(i)); break; }
  nsh = 0:n;
  t = 0;
  for (j = 1; j <= ncols(L[i]); j++)
  {
    if (L[i][j] != 0) { t++; nsh[t] = vdeg(L[i][j], sh); }
  }
  print("DEG " + string(i) + " " + string(nsh));
  sh = nsh;
}
print("END");
quit;
