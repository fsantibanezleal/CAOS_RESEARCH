ring r0 = 32003,(x,y,z),wp(1,1,2);
matrix D[3][3];
D[1,2] = -z;
def S = nc_algebra(1,D);
setring S;
module M = [(29843)*y^1*z^2+(24170)*y^3*z^1+(4416)*y^5+(4853)*x^1*z^2+(29402)*x^1*y^2*z^1+(24759)*x^1*y^4+(4521)*x^2*y^1*z^1+(2792)*x^2*y^3+(14843)*x^3*z^1+(25251)*x^3*y^2+(14063)*x^4*y^1+(1494)*x^5],[(18198)*y^1*z^2+(25246)*y^3*z^1+(19764)*y^5+(29510)*x^1*z^2+(18759)*x^1*y^2*z^1+(15176)*x^1*y^4+(19202)*x^2*y^1*z^1+(31030)*x^2*y^3+(3149)*x^3*z^1+(10092)*x^3*y^2+(24221)*x^4*y^1+(5982)*x^5];
intvec sh0 = 0;
proc vdeg(vector v, intvec sh)
{
  int i; intvec e;
  for (i = 1; i <= size(sh); i++)
  {
    if (v[i] != 0)
    {
      e = leadexp(v[i]);
      return(e[1] + e[2] + 2*e[3] + sh[i]);
    }
  }
  return(-1000000);
}
list L = mres(M, 0);
int i, j, n, t;
intvec sh = sh0;
intvec nsh;
print("DEG 0 " + string(sh0));
for (i = 1; i <= size(L); i++)
{
  n = 0;
  for (j = 1; j <= ncols(L[i]); j++) { if (L[i][j] != 0) { n++; } }
  if (n == 0) { print("DEG " + string(i)); break; }
  nsh = 0:n;
  t = 0;
  for (j = 1; j <= ncols(L[i]); j++)
  {
    if (L[i][j] != 0) { t++; nsh[t] = vdeg(L[i][j], sh); }
  }
  print("DEG " + string(i) + " " + string(nsh));
  sh = nsh;
}
print("END");
quit;
