ring r0 = 32003,(x,y,z),wp(1,1,2);
matrix D[3][3];
D[1,2] = -z;
def S = nc_algebra(1,D);
setring S;
module M = [(10075)*y^1+(5382)*x^1,(1641)*y^1+(25015)*x^1,(5705)*y^1+(18823)*x^1,(27645)*y^1+(26980)*x^1,(7165)*y^1+(27149)*x^1],[(4235)*y^1+(2571)*x^1,(15525)*y^1+(3193)*x^1,(31835)*y^1+(19833)*x^1,(27840)*y^1+(8616)*x^1,(20268)*y^1+(22825)*x^1],[(13196)*y^1+(13629)*x^1,(11515)*y^1+(10006)*x^1,(23425)*y^1+(12426)*x^1,(29991)*y^1+(1792)*x^1,(21073)*y^1+(1509)*x^1],[(17337)*y^1+(19225)*x^1,(31084)*y^1+(24034)*x^1,(28773)*y^1+(378)*x^1,(23643)*y^1+(29899)*x^1,(20262)*y^1+(15199)*x^1],[(9630)*y^1+(2309)*x^1,(22925)*y^1+(29081)*x^1,(5042)*y^1+(24714)*x^1,(21658)*y^1+(14417)*x^1,(7883)*y^1+(8311)*x^1],[(22595)*y^1+(11603)*x^1,(31895)*y^1+(22662)*x^1,(19190)*y^1+(17090)*x^1,(10536)*y^1+(11295)*x^1,(23772)*y^1+(15873)*x^1];
intvec sh0 = 0,0,0,0,0;
proc vdeg(vector v, intvec sh)
{
  int i; intvec e;
  for (i = 1; i <= size(sh); i++)
  {
    if (v[i] != 0)
    {
      e = leadexp(v[i]);
      return(e[1] + e[2] + 2*e[3] + sh[i]);
    }
  }
  return(-1000000);
}
list L = mres(M, 0);
int i, j, n, t;
intvec sh = sh0;
intvec nsh;
print("DEG 0 " + string(sh0));
for (i = 1; i <= size(L); i++)
{
  n = 0;
  for (j = 1; j <= ncols(L[i]); j++) { if (L[i][j] != 0) { n++; } }
  if (n == 0) { print("DEG " + string(i)); break; }
  nsh = 0:n;
  t = 0;
  for (j = 1; j <= ncols(L[i]); j++)
  {
    if (L[i][j] != 0) { t++; nsh[t] = vdeg(L[i][j], sh); }
  }
  print("DEG " + string(i) + " " + string(nsh));
  sh = nsh;
}
print("END");
quit;
