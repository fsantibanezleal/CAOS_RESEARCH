ring r0 = 32003,(x,y,z),wp(1,1,2);
matrix D[3][3];
D[1,2] = -z;
def S = nc_algebra(1,D);
setring S;
module M = [(3617)*y^1*z^1+(6488)*y^3+(20478)*x^1*z^1+(2686)*x^1*y^2+(25688)*x^2*y^1+(15522)*x^3,(16674)*y^1*z^1+(29491)*y^3+(5645)*x^1*z^1+(24632)*x^1*y^2+(5073)*x^2*y^1+(9481)*x^3],[(13702)*y^1*z^1+(13102)*y^3+(24932)*x^1*z^1+(12535)*x^1*y^2+(7195)*x^2*y^1+(26267)*x^3,(22880)*y^1*z^1+(954)*y^3+(7762)*x^1*z^1+(4928)*x^1*y^2+(9480)*x^2*y^1+(16091)*x^3],[(17469)*y^1*z^1+(14866)*y^3+(16579)*x^1*z^1+(15879)*x^1*y^2+(26299)*x^2*y^1+(31949)*x^3,(22966)*y^1*z^1+(27823)*y^3+(20255)*x^1*z^1+(3500)*x^1*y^2+(22975)*x^2*y^1+(17789)*x^3];
intvec sh0 = 0,0;
proc vdeg(vector v, intvec sh)
{
  int i; intvec e;
  for (i = 1; i <= size(sh); i++)
  {
    if (v[i] != 0)
    {
      e = leadexp(v[i]);
      return(e[1] + e[2] + 2*e[3] + sh[i]);
    }
  }
  return(-1000000);
}
list L = mres(M, 0);
int i, j, n, t;
intvec sh = sh0;
intvec nsh;
print("DEG 0 " + string(sh0));
for (i = 1; i <= size(L); i++)
{
  n = 0;
  for (j = 1; j <= ncols(L[i]); j++) { if (L[i][j] != 0) { n++; } }
  if (n == 0) { print("DEG " + string(i)); break; }
  nsh = 0:n;
  t = 0;
  for (j = 1; j <= ncols(L[i]); j++)
  {
    if (L[i][j] != 0) { t++; nsh[t] = vdeg(L[i][j], sh); }
  }
  print("DEG " + string(i) + " " + string(nsh));
  sh = nsh;
}
print("END");
quit;
