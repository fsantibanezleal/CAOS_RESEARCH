ring r0 = 32003,(x,y,z),wp(1,1,2);
matrix D[3][3];
D[1,2] = -z;
def S = nc_algebra(1,D);
setring S;
module M = [(21509)*y^1*z^2+(2449)*y^3*z^1+(29206)*y^5+(28953)*x^1*z^2+(21475)*x^1*y^2*z^1+(16116)*x^1*y^4+(2650)*x^2*y^1*z^1+(17527)*x^2*y^3+(13690)*x^3*z^1+(24148)*x^3*y^2+(25404)*x^4*y^1+(11591)*x^5],[(23543)*y^1*z^2+(2579)*y^3*z^1+(9319)*y^5+(18507)*x^1*z^2+(18491)*x^1*y^2*z^1+(24504)*x^1*y^4+(22498)*x^2*y^1*z^1+(10943)*x^2*y^3+(8082)*x^3*z^1+(27004)*x^3*y^2+(9700)*x^4*y^1+(16799)*x^5];
intvec sh0 = 0;
proc vdeg(vector v, intvec sh)
{
  int i; intvec e;
  for (i = 1; i <= size(sh); i++)
  {
    if (v[i] != 0)
    {
      e = leadexp(v[i]);
      return(e[1] + e[2] + 2*e[3] + sh[i]);
    }
  }
  return(-1000000);
}
list L = mres(M, 0);
int i, j, n, t;
intvec sh = sh0;
intvec nsh;
print("DEG 0 " + string(sh0));
for (i = 1; i <= size(L); i++)
{
  n = 0;
  for (j = 1; j <= ncols(L[i]); j++) { if (L[i][j] != 0) { n++; } }
  if (n == 0) { print("DEG " + string(i)); break; }
  nsh = 0:n;
  t = 0;
  for (j = 1; j <= ncols(L[i]); j++)
  {
    if (L[i][j] != 0) { t++; nsh[t] = vdeg(L[i][j], sh); }
  }
  print("DEG " + string(i) + " " + string(nsh));
  sh = nsh;
}
print("END");
quit;
