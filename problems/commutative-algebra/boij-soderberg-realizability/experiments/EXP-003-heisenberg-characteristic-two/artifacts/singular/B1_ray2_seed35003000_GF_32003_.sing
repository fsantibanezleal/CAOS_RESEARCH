ring r0 = 32003,(x,y,z),wp(1,1,2);
matrix D[3][3];
D[1,2] = -z;
def S = nc_algebra(1,D);
setring S;
module M = [(7401)*y^1+(20308)*x^1,(16114)*y^1+(22005)*x^1,(29317)*y^1+(21169)*x^1,(23939)*y^1+(3811)*x^1],[(19713)*y^1+(6796)*x^1,(928)*y^1+(1917)*x^1,(21644)*y^1+(2324)*x^1,(18736)*y^1+(21824)*x^1],[(13137)*y^1+(22286)*x^1,(8202)*y^1+(5172)*x^1,(15138)*y^1+(15933)*x^1,(12161)*y^1+(7121)*x^1],[(20842)*y^1+(10671)*x^1,(2805)*y^1+(27113)*x^1,(29648)*y^1+(15123)*x^1,(6673)*y^1+(14142)*x^1],[(4690)*y^1+(5850)*x^1,(30326)*y^1+(22567)*x^1,(8967)*y^1+(14659)*x^1,(17906)*y^1+(13457)*x^1];
intvec sh0 = 0,0,0,0;
proc vdeg(vector v, intvec sh)
{
  int i; intvec e;
  for (i = 1; i <= size(sh); i++)
  {
    if (v[i] != 0)
    {
      e = leadexp(v[i]);
      return(e[1] + e[2] + 2*e[3] + sh[i]);
    }
  }
  return(-1000000);
}
list L = mres(M, 0);
int i, j, n, t;
intvec sh = sh0;
intvec nsh;
print("DEG 0 " + string(sh0));
for (i = 1; i <= size(L); i++)
{
  n = 0;
  for (j = 1; j <= ncols(L[i]); j++) { if (L[i][j] != 0) { n++; } }
  if (n == 0) { print("DEG " + string(i)); break; }
  nsh = 0:n;
  t = 0;
  for (j = 1; j <= ncols(L[i]); j++)
  {
    if (L[i][j] != 0) { t++; nsh[t] = vdeg(L[i][j], sh); }
  }
  print("DEG " + string(i) + " " + string(nsh));
  sh = nsh;
}
print("END");
quit;
