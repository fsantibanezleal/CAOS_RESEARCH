ring r0 = 32003,(x,y,z),wp(1,1,2);
matrix D[3][3];
D[1,2] = -z;
def S = nc_algebra(1,D);
setring S;
module M = [(18045)*y^1*z^1+(14684)*y^3+(21580)*x^1*z^1+(30894)*x^1*y^2+(20804)*x^2*y^1+(12627)*x^3],[(17740)*y^1*z^1+(24377)*y^3+(5241)*x^1*z^1+(14187)*x^1*y^2+(28928)*x^2*y^1+(19496)*x^3],[(27183)*y^1*z^1+(15130)*y^3+(9769)*x^1*z^1+(11594)*x^1*y^2+(17864)*x^2*y^1+(3036)*x^3],[(24192)*y^1*z^1+(26036)*y^3+(11641)*x^1*z^1+(15248)*x^1*y^2+(26670)*x^2*y^1+(31061)*x^3];
intvec sh0 = 0;
proc vdeg(vector v, intvec sh)
{
  int i; intvec e;
  for (i = 1; i <= size(sh); i++)
  {
    if (v[i] != 0)
    {
      e = leadexp(v[i]);
      return(e[1] + e[2] + 2*e[3] + sh[i]);
    }
  }
  return(-1000000);
}
list L = mres(M, 0);
int i, j, n, t;
intvec sh = sh0;
intvec nsh;
print("DEG 0 " + string(sh0));
for (i = 1; i <= size(L); i++)
{
  n = 0;
  for (j = 1; j <= ncols(L[i]); j++) { if (L[i][j] != 0) { n++; } }
  if (n == 0) { print("DEG " + string(i)); break; }
  nsh = 0:n;
  t = 0;
  for (j = 1; j <= ncols(L[i]); j++)
  {
    if (L[i][j] != 0) { t++; nsh[t] = vdeg(L[i][j], sh); }
  }
  print("DEG " + string(i) + " " + string(nsh));
  sh = nsh;
}
print("END");
quit;
