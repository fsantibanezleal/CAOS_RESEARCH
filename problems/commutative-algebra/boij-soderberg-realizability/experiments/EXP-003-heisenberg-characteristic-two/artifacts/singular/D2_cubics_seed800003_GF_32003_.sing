ring r0 = 32003,(x,y,z),wp(1,1,2);
matrix D[3][3];
D[1,2] = -z;
def S = nc_algebra(1,D);
setring S;
module M = [(28362)*y^1*z^1+(4575)*y^3+(28823)*x^1*z^1+(29365)*x^1*y^2+(620)*x^2*y^1+(4877)*x^3,(31564)*y^1*z^1+(23107)*y^3+(27249)*x^1*z^1+(2309)*x^1*y^2+(25497)*x^2*y^1+(30776)*x^3],[(12562)*y^1*z^1+(12389)*y^3+(31535)*x^1*z^1+(16154)*x^1*y^2+(13050)*x^2*y^1+(1408)*x^3,(19014)*y^1*z^1+(10853)*y^3+(3656)*x^1*z^1+(30666)*x^1*y^2+(5203)*x^2*y^1+(4323)*x^3],[(3366)*y^1*z^1+(26018)*y^3+(4100)*x^1*z^1+(5723)*x^1*y^2+(6750)*x^2*y^1+(27063)*x^3,(15147)*y^1*z^1+(25446)*y^3+(15388)*x^1*z^1+(2739)*x^1*y^2+(31050)*x^2*y^1+(17590)*x^3];
intvec sh0 = 0,0;
proc vdeg(vector v, intvec sh)
{
  int i; intvec e;
  for (i = 1; i <= size(sh); i++)
  {
    if (v[i] != 0)
    {
      e = leadexp(v[i]);
      return(e[1] + e[2] + 2*e[3] + sh[i]);
    }
  }
  return(-1000000);
}
list L = mres(M, 0);
int i, j, n, t;
intvec sh = sh0;
intvec nsh;
print("DEG 0 " + string(sh0));
for (i = 1; i <= size(L); i++)
{
  n = 0;
  for (j = 1; j <= ncols(L[i]); j++) { if (L[i][j] != 0) { n++; } }
  if (n == 0) { print("DEG " + string(i)); break; }
  nsh = 0:n;
  t = 0;
  for (j = 1; j <= ncols(L[i]); j++)
  {
    if (L[i][j] != 0) { t++; nsh[t] = vdeg(L[i][j], sh); }
  }
  print("DEG " + string(i) + " " + string(nsh));
  sh = nsh;
}
print("END");
quit;
