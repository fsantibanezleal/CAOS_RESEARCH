ring r0 = 32003,(x,y,z),wp(1,1,2);
matrix D[3][3];
D[1,2] = -z;
def S = nc_algebra(1,D);
setring S;
module M = [(13361)*z^1+(11406)*y^2+(976)*x^1*y^1+(26058)*x^2,(29545)*z^1+(19038)*y^2+(14857)*x^1*y^1+(15654)*x^2],[(28440)*z^1+(31972)*y^2+(19961)*x^1*y^1+(8356)*x^2,(17996)*z^1+(5204)*y^2+(650)*x^1*y^1+(13341)*x^2],[(3864)*z^1+(16861)*y^2+(14601)*x^1*y^1+(28271)*x^2,(4303)*z^1+(15856)*y^2+(31048)*x^1*y^1+(1776)*x^2];
intvec sh0 = 0,0;
proc vdeg(vector v, intvec sh)
{
  int i; intvec e;
  for (i = 1; i <= size(sh); i++)
  {
    if (v[i] != 0)
    {
      e = leadexp(v[i]);
      return(e[1] + e[2] + 2*e[3] + sh[i]);
    }
  }
  return(-1000000);
}
list L = mres(M, 0);
int i, j, n, t;
intvec sh = sh0;
intvec nsh;
print("DEG 0 " + string(sh0));
for (i = 1; i <= size(L); i++)
{
  n = 0;
  for (j = 1; j <= ncols(L[i]); j++) { if (L[i][j] != 0) { n++; } }
  if (n == 0) { print("DEG " + string(i)); break; }
  nsh = 0:n;
  t = 0;
  for (j = 1; j <= ncols(L[i]); j++)
  {
    if (L[i][j] != 0) { t++; nsh[t] = vdeg(L[i][j], sh); }
  }
  print("DEG " + string(i) + " " + string(nsh));
  sh = nsh;
}
print("END");
quit;
