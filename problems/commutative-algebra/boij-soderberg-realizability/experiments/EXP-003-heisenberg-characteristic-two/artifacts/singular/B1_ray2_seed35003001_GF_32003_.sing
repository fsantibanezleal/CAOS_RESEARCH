ring r0 = 32003,(x,y,z),wp(1,1,2);
matrix D[3][3];
D[1,2] = -z;
def S = nc_algebra(1,D);
setring S;
module M = [(26696)*y^1+(28747)*x^1,(17307)*y^1+(11751)*x^1,(25238)*y^1+(23694)*x^1,(12486)*y^1+(1140)*x^1],[(27014)*y^1+(27164)*x^1,(24129)*y^1+(19349)*x^1,(31634)*y^1+(11698)*x^1,(446)*y^1+(24386)*x^1],[(14721)*y^1+(15945)*x^1,(31064)*y^1+(8822)*x^1,(1818)*y^1+(30054)*x^1,(4034)*y^1+(12162)*x^1],[(7922)*y^1+(17883)*x^1,(30995)*y^1+(26047)*x^1,(30370)*y^1+(19798)*x^1,(13462)*y^1+(5225)*x^1],[(20119)*y^1+(29294)*x^1,(19830)*y^1+(14133)*x^1,(12806)*y^1+(30944)*x^1,(21259)*y^1+(14466)*x^1];
intvec sh0 = 0,0,0,0;
proc vdeg(vector v, intvec sh)
{
  int i; intvec e;
  for (i = 1; i <= size(sh); i++)
  {
    if (v[i] != 0)
    {
      e = leadexp(v[i]);
      return(e[1] + e[2] + 2*e[3] + sh[i]);
    }
  }
  return(-1000000);
}
list L = mres(M, 0);
int i, j, n, t;
intvec sh = sh0;
intvec nsh;
print("DEG 0 " + string(sh0));
for (i = 1; i <= size(L); i++)
{
  n = 0;
  for (j = 1; j <= ncols(L[i]); j++) { if (L[i][j] != 0) { n++; } }
  if (n == 0) { print("DEG " + string(i)); break; }
  nsh = 0:n;
  t = 0;
  for (j = 1; j <= ncols(L[i]); j++)
  {
    if (L[i][j] != 0) { t++; nsh[t] = vdeg(L[i][j], sh); }
  }
  print("DEG " + string(i) + " " + string(nsh));
  sh = nsh;
}
print("END");
quit;
