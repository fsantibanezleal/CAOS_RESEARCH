ring r0 = 32003,(x,y,z),wp(1,1,2);
matrix D[3][3];
D[1,2] = -z;
def S = nc_algebra(1,D);
setring S;
module M = [(25636)*z^1+(7773)*y^2+(11638)*x^1*y^1+(13972)*x^2,(30818)*z^1+(30436)*y^2+(29098)*x^1*y^1+(10626)*x^2],[(24894)*z^1+(16005)*y^2+(23391)*x^1*y^1+(18795)*x^2,(6363)*z^1+(6843)*y^2+(21553)*x^1*y^1+(27510)*x^2],[(9766)*z^1+(29434)*y^2+(1226)*x^1*y^1+(30738)*x^2,(24428)*z^1+(31651)*y^2+(30894)*x^1*y^1+(4199)*x^2];
intvec sh0 = 0,0;
proc vdeg(vector v, intvec sh)
{
  int i; intvec e;
  for (i = 1; i <= size(sh); i++)
  {
    if (v[i] != 0)
    {
      e = leadexp(v[i]);
      return(e[1] + e[2] + 2*e[3] + sh[i]);
    }
  }
  return(-1000000);
}
list L = mres(M, 0);
int i, j, n, t;
intvec sh = sh0;
intvec nsh;
print("DEG 0 " + string(sh0));
for (i = 1; i <= size(L); i++)
{
  n = 0;
  for (j = 1; j <= ncols(L[i]); j++) { if (L[i][j] != 0) { n++; } }
  if (n == 0) { print("DEG " + string(i)); break; }
  nsh = 0:n;
  t = 0;
  for (j = 1; j <= ncols(L[i]); j++)
  {
    if (L[i][j] != 0) { t++; nsh[t] = vdeg(L[i][j], sh); }
  }
  print("DEG " + string(i) + " " + string(nsh));
  sh = nsh;
}
print("END");
quit;
