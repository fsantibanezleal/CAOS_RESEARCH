ring r0 = 32003,(x,y,z),wp(1,1,2);
matrix D[3][3];
D[1,2] = -z;
def S = nc_algebra(1,D);
setring S;
module M = [(6017)*z^2+(17327)*y^2*z^1+(3731)*y^4+(13476)*x^1*y^1*z^1+(22834)*x^1*y^3+(1399)*x^2*z^1+(8685)*x^2*y^2+(21990)*x^3*y^1+(30433)*x^4],[(5545)*z^2+(7621)*y^2*z^1+(7709)*y^4+(30176)*x^1*y^1*z^1+(10881)*x^1*y^3+(29665)*x^2*z^1+(8206)*x^2*y^2+(17552)*x^3*y^1+(28218)*x^4];
intvec sh0 = 0;
proc vdeg(vector v, intvec sh)
{
  int i; intvec e;
  for (i = 1; i <= size(sh); i++)
  {
    if (v[i] != 0)
    {
      e = leadexp(v[i]);
      return(e[1] + e[2] + 2*e[3] + sh[i]);
    }
  }
  return(-1000000);
}
list L = mres(M, 0);
int i, j, n, t;
intvec sh = sh0;
intvec nsh;
print("DEG 0 " + string(sh0));
for (i = 1; i <= size(L); i++)
{
  n = 0;
  for (j = 1; j <= ncols(L[i]); j++) { if (L[i][j] != 0) { n++; } }
  if (n == 0) { print("DEG " + string(i)); break; }
  nsh = 0:n;
  t = 0;
  for (j = 1; j <= ncols(L[i]); j++)
  {
    if (L[i][j] != 0) { t++; nsh[t] = vdeg(L[i][j], sh); }
  }
  print("DEG " + string(i) + " " + string(nsh));
  sh = nsh;
}
print("END");
quit;
