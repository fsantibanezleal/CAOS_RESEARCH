ring r0 = 32003,(x,y,z),wp(1,1,2);
matrix D[3][3];
D[1,2] = -z;
def S = nc_algebra(1,D);
setring S;
module M = [(4828)*y^1+(2019)*x^1,(19155)*y^1+(6827)*x^1,(15827)*y^1+(15997)*x^1,(12180)*y^1+(9830)*x^1,(18428)*y^1+(20605)*x^1],[(26393)*y^1+(24617)*x^1,(27027)*y^1+(24860)*x^1,(28053)*y^1+(978)*x^1,(10032)*y^1+(18080)*x^1,(22000)*y^1+(9504)*x^1],[(6170)*y^1+(17658)*x^1,(4653)*y^1+(28495)*x^1,(3906)*y^1+(4974)*x^1,(13177)*y^1+(19500)*x^1,(31456)*y^1+(31761)*x^1],[(12208)*y^1+(15912)*x^1,(4185)*y^1+(2794)*x^1,(20282)*y^1+(13682)*x^1,(21681)*y^1+(25885)*x^1,(4989)*y^1+(15408)*x^1],[(565)*y^1+(16478)*x^1,(29333)*y^1+(25991)*x^1,(4636)*y^1+(27979)*x^1,(6114)*y^1+(16900)*x^1,(15649)*y^1+(2728)*x^1],[(7933)*y^1+(27887)*x^1,(21500)*y^1+(25976)*x^1,(13617)*y^1+(2346)*x^1,(21709)*y^1+(12725)*x^1,(11960)*y^1+(2817)*x^1];
intvec sh0 = 0,0,0,0,0;
proc vdeg(vector v, intvec sh)
{
  int i; intvec e;
  for (i = 1; i <= size(sh); i++)
  {
    if (v[i] != 0)
    {
      e = leadexp(v[i]);
      return(e[1] + e[2] + 2*e[3] + sh[i]);
    }
  }
  return(-1000000);
}
list L = mres(M, 0);
int i, j, n, t;
intvec sh = sh0;
intvec nsh;
print("DEG 0 " + string(sh0));
for (i = 1; i <= size(L); i++)
{
  n = 0;
  for (j = 1; j <= ncols(L[i]); j++) { if (L[i][j] != 0) { n++; } }
  if (n == 0) { print("DEG " + string(i)); break; }
  nsh = 0:n;
  t = 0;
  for (j = 1; j <= ncols(L[i]); j++)
  {
    if (L[i][j] != 0) { t++; nsh[t] = vdeg(L[i][j], sh); }
  }
  print("DEG " + string(i) + " " + string(nsh));
  sh = nsh;
}
print("END");
quit;
