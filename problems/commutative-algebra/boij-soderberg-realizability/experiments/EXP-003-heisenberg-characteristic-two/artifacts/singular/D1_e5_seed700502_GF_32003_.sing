ring r0 = 32003,(x,y,z),wp(1,1,2);
matrix D[3][3];
D[1,2] = -z;
def S = nc_algebra(1,D);
setring S;
module M = [(3015)*y^1*z^2+(5115)*y^3*z^1+(15133)*y^5+(7707)*x^1*z^2+(27356)*x^1*y^2*z^1+(22387)*x^1*y^4+(19020)*x^2*y^1*z^1+(16235)*x^2*y^3+(3092)*x^3*z^1+(200)*x^3*y^2+(26269)*x^4*y^1+(18644)*x^5],[(26548)*y^1*z^2+(5917)*y^3*z^1+(14537)*y^5+(23814)*x^1*z^2+(30957)*x^1*y^2*z^1+(11017)*x^1*y^4+(13562)*x^2*y^1*z^1+(1338)*x^2*y^3+(358)*x^3*z^1+(7289)*x^3*y^2+(17777)*x^4*y^1+(26565)*x^5];
intvec sh0 = 0;
proc vdeg(vector v, intvec sh)
{
  int i; intvec e;
  for (i = 1; i <= size(sh); i++)
  {
    if (v[i] != 0)
    {
      e = leadexp(v[i]);
      return(e[1] + e[2] + 2*e[3] + sh[i]);
    }
  }
  return(-1000000);
}
list L = mres(M, 0);
int i, j, n, t;
intvec sh = sh0;
intvec nsh;
print("DEG 0 " + string(sh0));
for (i = 1; i <= size(L); i++)
{
  n = 0;
  for (j = 1; j <= ncols(L[i]); j++) { if (L[i][j] != 0) { n++; } }
  if (n == 0) { print("DEG " + string(i)); break; }
  nsh = 0:n;
  t = 0;
  for (j = 1; j <= ncols(L[i]); j++)
  {
    if (L[i][j] != 0) { t++; nsh[t] = vdeg(L[i][j], sh); }
  }
  print("DEG " + string(i) + " " + string(nsh));
  sh = nsh;
}
print("END");
quit;
