ring r0 = 32003,(x,y,z),wp(1,1,2);
matrix D[3][3];
D[1,2] = -z;
def S = nc_algebra(1,D);
setring S;
module M = [(4364)*y^1+(17043)*x^1,(18392)*y^1+(15616)*x^1,(23491)*y^1+(8724)*x^1,(5292)*y^1+(22626)*x^1,(2553)*y^1+(30058)*x^1],[(29324)*y^1+(16175)*x^1,(22666)*y^1+(2443)*x^1,(26579)*y^1+(7020)*x^1,(9511)*y^1+(12374)*x^1,(22090)*y^1+(27131)*x^1],[(12707)*y^1+(25545)*x^1,(11188)*y^1+(16125)*x^1,(30787)*y^1+(8777)*x^1,(18045)*y^1+(9742)*x^1,(17273)*y^1+(17293)*x^1],[(21989)*y^1+(29437)*x^1,(27252)*y^1+(4980)*x^1,(11055)*y^1+(15308)*x^1,(12024)*y^1+(28008)*x^1,(5512)*y^1+(29150)*x^1],[(5586)*y^1+(3531)*x^1,(10536)*y^1+(12670)*x^1,(19890)*y^1+(28217)*x^1,(21408)*y^1+(5317)*x^1,(31843)*y^1+(8326)*x^1],[(5722)*y^1+(26024)*x^1,(23065)*y^1+(27903)*x^1,(15509)*y^1+(30318)*x^1,(902)*y^1+(7880)*x^1,(337)*y^1+(13363)*x^1];
intvec sh0 = 0,0,0,0,0;
proc vdeg(vector v, intvec sh)
{
  int i; intvec e;
  for (i = 1; i <= size(sh); i++)
  {
    if (v[i] != 0)
    {
      e = leadexp(v[i]);
      return(e[1] + e[2] + 2*e[3] + sh[i]);
    }
  }
  return(-1000000);
}
list L = mres(M, 0);
int i, j, n, t;
intvec sh = sh0;
intvec nsh;
print("DEG 0 " + string(sh0));
for (i = 1; i <= size(L); i++)
{
  n = 0;
  for (j = 1; j <= ncols(L[i]); j++) { if (L[i][j] != 0) { n++; } }
  if (n == 0) { print("DEG " + string(i)); break; }
  nsh = 0:n;
  t = 0;
  for (j = 1; j <= ncols(L[i]); j++)
  {
    if (L[i][j] != 0) { t++; nsh[t] = vdeg(L[i][j], sh); }
  }
  print("DEG " + string(i) + " " + string(nsh));
  sh = nsh;
}
print("END");
quit;
