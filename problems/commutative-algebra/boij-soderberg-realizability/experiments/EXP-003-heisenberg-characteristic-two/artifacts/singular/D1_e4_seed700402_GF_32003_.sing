ring r0 = 32003,(x,y,z),wp(1,1,2);
matrix D[3][3];
D[1,2] = -z;
def S = nc_algebra(1,D);
setring S;
module M = [(29549)*z^2+(2816)*y^2*z^1+(14371)*y^4+(27106)*x^1*y^1*z^1+(2319)*x^1*y^3+(21971)*x^2*z^1+(9869)*x^2*y^2+(31901)*x^3*y^1+(17486)*x^4],[(5357)*z^2+(1238)*y^2*z^1+(16984)*y^4+(5524)*x^1*y^1*z^1+(15767)*x^1*y^3+(27232)*x^2*z^1+(4950)*x^2*y^2+(5428)*x^3*y^1+(8443)*x^4];
intvec sh0 = 0;
proc vdeg(vector v, intvec sh)
{
  int i; intvec e;
  for (i = 1; i <= size(sh); i++)
  {
    if (v[i] != 0)
    {
      e = leadexp(v[i]);
      return(e[1] + e[2] + 2*e[3] + sh[i]);
    }
  }
  return(-1000000);
}
list L = mres(M, 0);
int i, j, n, t;
intvec sh = sh0;
intvec nsh;
print("DEG 0 " + string(sh0));
for (i = 1; i <= size(L); i++)
{
  n = 0;
  for (j = 1; j <= ncols(L[i]); j++) { if (L[i][j] != 0) { n++; } }
  if (n == 0) { print("DEG " + string(i)); break; }
  nsh = 0:n;
  t = 0;
  for (j = 1; j <= ncols(L[i]); j++)
  {
    if (L[i][j] != 0) { t++; nsh[t] = vdeg(L[i][j], sh); }
  }
  print("DEG " + string(i) + " " + string(nsh));
  sh = nsh;
}
print("END");
quit;
