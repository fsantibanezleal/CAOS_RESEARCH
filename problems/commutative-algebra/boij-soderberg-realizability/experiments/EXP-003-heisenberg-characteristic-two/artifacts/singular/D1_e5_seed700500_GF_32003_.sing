ring r0 = 32003,(x,y,z),wp(1,1,2);
matrix D[3][3];
D[1,2] = -z;
def S = nc_algebra(1,D);
setring S;
module M = [(29010)*y^1*z^2+(29527)*y^3*z^1+(31495)*y^5+(12257)*x^1*z^2+(5990)*x^1*y^2*z^1+(24164)*x^1*y^4+(24860)*x^2*y^1*z^1+(6566)*x^2*y^3+(27259)*x^3*z^1+(7237)*x^3*y^2+(12979)*x^4*y^1+(12774)*x^5],[(16803)*y^1*z^2+(8703)*y^3*z^1+(12219)*y^5+(24184)*x^1*z^2+(629)*x^1*y^2*z^1+(20067)*x^1*y^4+(464)*x^2*y^1*z^1+(15951)*x^2*y^3+(28733)*x^3*z^1+(582)*x^3*y^2+(6608)*x^4*y^1+(24266)*x^5];
intvec sh0 = 0;
proc vdeg(vector v, intvec sh)
{
  int i; intvec e;
  for (i = 1; i <= size(sh); i++)
  {
    if (v[i] != 0)
    {
      e = leadexp(v[i]);
      return(e[1] + e[2] + 2*e[3] + sh[i]);
    }
  }
  return(-1000000);
}
list L = mres(M, 0);
int i, j, n, t;
intvec sh = sh0;
intvec nsh;
print("DEG 0 " + string(sh0));
for (i = 1; i <= size(L); i++)
{
  n = 0;
  for (j = 1; j <= ncols(L[i]); j++) { if (L[i][j] != 0) { n++; } }
  if (n == 0) { print("DEG " + string(i)); break; }
  nsh = 0:n;
  t = 0;
  for (j = 1; j <= ncols(L[i]); j++)
  {
    if (L[i][j] != 0) { t++; nsh[t] = vdeg(L[i][j], sh); }
  }
  print("DEG " + string(i) + " " + string(nsh));
  sh = nsh;
}
print("END");
quit;
