ring r0 = 32003,(x,y,z),wp(1,1,2);
matrix D[3][3];
D[1,2] = -z;
def S = nc_algebra(1,D);
setring S;
module M = [(27108)*z^5+(17936)*y^2*z^4+(11066)*y^4*z^3+(25414)*y^6*z^2+(7518)*y^8*z^1+(5118)*y^10+(1360)*x^1*y^1*z^4+(10682)*x^1*y^3*z^3+(9886)*x^1*y^5*z^2+(27487)*x^1*y^7*z^1+(7410)*x^1*y^9+(27559)*x^2*z^4+(8830)*x^2*y^2*z^3+(3659)*x^2*y^4*z^2+(22927)*x^2*y^6*z^1+(23852)*x^2*y^8+(10512)*x^3*y^1*z^3+(24244)*x^3*y^3*z^2+(17694)*x^3*y^5*z^1+(35)*x^3*y^7+(3507)*x^4*z^3+(3517)*x^4*y^2*z^2+(5671)*x^4*y^4*z^1+(29237)*x^4*y^6+(10938)*x^5*y^1*z^2+(9507)*x^5*y^3*z^1+(13374)*x^5*y^5+(23018)*x^6*z^2+(20623)*x^6*y^2*z^1+(13170)*x^6*y^4+(724)*x^7*y^1*z^1+(11320)*x^7*y^3+(8107)*x^8*z^1+(21150)*x^8*y^2+(17115)*x^9*y^1+(24942)*x^10],[(19295)*z^5+(16620)*y^2*z^4+(420)*y^4*z^3+(19981)*y^6*z^2+(6541)*y^8*z^1+(5675)*y^10+(16684)*x^1*y^1*z^4+(8429)*x^1*y^3*z^3+(11785)*x^1*y^5*z^2+(17577)*x^1*y^7*z^1+(24539)*x^1*y^9+(6612)*x^2*z^4+(921)*x^2*y^2*z^3+(18950)*x^2*y^4*z^2+(10401)*x^2*y^6*z^1+(9029)*x^2*y^8+(27719)*x^3*y^1*z^3+(22512)*x^3*y^3*z^2+(23667)*x^3*y^5*z^1+(31231)*x^3*y^7+(10480)*x^4*z^3+(10673)*x^4*y^2*z^2+(25609)*x^4*y^4*z^1+(19568)*x^4*y^6+(7114)*x^5*y^1*z^2+(14960)*x^5*y^3*z^1+(29808)*x^5*y^5+(10457)*x^6*z^2+(4068)*x^6*y^2*z^1+(28607)*x^6*y^4+(24802)*x^7*y^1*z^1+(21694)*x^7*y^3+(8232)*x^8*z^1+(30660)*x^8*y^2+(22198)*x^9*y^1+(9970)*x^10];
intvec sh0 = 0;
proc vdeg(vector v, intvec sh)
{
  int i; intvec e;
  for (i = 1; i <= size(sh); i++)
  {
    if (v[i] != 0)
    {
      e = leadexp(v[i]);
      return(e[1] + e[2] + 2*e[3] + sh[i]);
    }
  }
  return(-1000000);
}
list L = mres(M, 0);
int i, j, n, t;
intvec sh = sh0;
intvec nsh;
print("DEG 0 " + string(sh0));
for (i = 1; i <= size(L); i++)
{
  n = 0;
  for (j = 1; j <= ncols(L[i]); j++) { if (L[i][j] != 0) { n++; } }
  if (n == 0) { print("DEG " + string(i)); break; }
  nsh = 0:n;
  t = 0;
  for (j = 1; j <= ncols(L[i]); j++)
  {
    if (L[i][j] != 0) { t++; nsh[t] = vdeg(L[i][j], sh); }
  }
  print("DEG " + string(i) + " " + string(nsh));
  sh = nsh;
}
print("END");
quit;
