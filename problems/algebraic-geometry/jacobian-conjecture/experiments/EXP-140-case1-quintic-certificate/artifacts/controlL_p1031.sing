ring R=1031,(q0,q1,q2,q3,q4,q5),dp;
option(redSB);
ideal I=
(405)*q1^2+(1009)*q1^4+(655),
(802)+(732)*q1^2+(365)*q1^4,
(991)*q0^2*q1+(645)*q0^2*q1^3+(52)*q0*q1^2+(814)*q0*q1^4+(224)*q0+(2)*q0*q2+(403)*q0*q1^2*q2+(1029)*q0*q1*q4+(862)*q1^3+(12)*q1^5+(493)*q1+(733)*q1*q2+(716)*q1^3*q2+(754)*q1^2*q4+(829)*q1*q5+(635)*q1*q2^2+(273)*q1^2*q3+(32)*q3+(994)*q4+(408)*q2*q4+(325)*q0*q5+(965)*q0^2*q1*q2+(569)*q0^3*q1^2+(997)*q0*q1*q3+(825)*q0^4*q1+(104)*q0^3+(600)*q0*q2^2+(658)*q0^2*q4+(169)*q2*q3+(326)*q0^3*q2+(444)*q0^5+(32)*q0^2*q3,
(259)*q0*q1^2+(832)*q0*q1^4+(391)*q1^3+(248)*q1^5+(59)*q1+(384)*q1*q2+(890)*q1^3*q2+(193)*q1^2*q4+(197)*q0+(637)*q4;
