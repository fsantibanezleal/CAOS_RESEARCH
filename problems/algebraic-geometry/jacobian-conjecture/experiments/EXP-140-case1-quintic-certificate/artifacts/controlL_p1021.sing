(501)*q1^2+(134)*q1^4+(474),
(607)+(144)*q1^2+(387)*q1^4,
(556)*q0^2*q1+(245)*q0^2*q1^3+(782)*q0*q1^2+(163)*q0*q1^4+(897)*q0+(131)*q0*q2+(132)*q0*q1^2*q2+(183)*q0*q1*q4+(312)*q1^3+(186)*q1^5+(1008)*q1+(866)*q1*q2+(185)*q1^3*q2+(796)*q1^2*q4+(224)*q1*q5+(366)*q1*q2^2+(936)*q1^2*q3+(517)*q3+(385)*q4+(526)*q2*q4+(515)*q0*q5+(258)*q0^2*q1*q2+(501)*q0^3*q1^2+(533)*q0*q1*q3+(332)*q0^4*q1+(600)*q0^3+(189)*q0*q2^2+(993)*q0^2*q4+(969)*q2*q3+(1002)*q0^3*q2+(90)*q0^5+(220)*q0^2*q3,
