(22)*q1^2+(245)*q1^4+(751),
(421)+(817)*q1^2+(224)*q1^4,
(121)*q0^2*q1+(213)*q0^2*q1^3+(245)*q0*q1^2+(796)*q0*q1^4+(962)*q0+(453)*q0*q2+(155)*q0*q1^2*q2+(94)*q0*q1*q4+(588)*q1^3+(314)*q1^5+(505)*q1+(656)*q1*q2+(806)*q1^3*q2+(564)*q1^2*q4+(654)*q1*q5+(515)*q1*q2^2+(841)*q1^2*q3+(542)*q3+(570)*q4+(344)*q2*q4+(132)*q0*q5+(295)*q0^2*q1*q2+(583)*q0^3*q1^2+(389)*q0*q1*q3+(1011)*q0^4*q1+(904)*q0^3+(650)*q0*q2^2+(489)*q0^2*q4+(299)*q2*q3+(805)*q0^3*q2+(671)*q0^5+(169)*q0^2*q3,
