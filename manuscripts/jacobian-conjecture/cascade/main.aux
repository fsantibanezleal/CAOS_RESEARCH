\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Index map of the five conjectures indexed by an integer. Each cell is one index from 1 to 16 of the conjecture in its row. W: false with an explicit witness; I: false by an implication from another statement; T: true; ?: open; the dashes mark $N=1$, where $SU(1)$ is the trivial group and the conjecture holds trivially. Cells beyond 16 repeat the last column. In the Mathieu row every cell from $N=2$ is W: the pair $(P,Q)$ of Long is an explicit witness, whose moments are checked here for $N\le 16$ and covered by Proposition~\ref {prop:longsun} for every $N\ge 2$. Built from the closure of computation \mbox  {EXP-136} with the Poisson and Mathieu rows amended.}}{28}{figure.83}\protected@file@percent }
\newlabel{fig:index}{{2}{28}{Index map of the five conjectures indexed by an integer. Each cell is one index from 1 to 16 of the conjecture in its row. W: false with an explicit witness; I: false by an implication from another statement; T: true; ?: open; the dashes mark $N=1$, where $SU(1)$ is the trivial group and the conjecture holds trivially. Cells beyond 16 repeat the last column. In the Mathieu row every cell from $N=2$ is W: the pair $(P,Q)$ of Long is an explicit witness, whose moments are checked here for $N\le \nmcnmax $ and covered by Proposition~\ref {prop:longsun} for every $N\ge 2$. Built from the closure of computation \EXP {136} with the Poisson and Mathieu rows amended}{figure.83}{}}
