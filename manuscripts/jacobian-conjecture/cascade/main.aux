\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Exact values of $\DOTSI \intop \ilimits@ _{SU(N)}Q^sP^m\,dg$ for Long's pair, from the complex sphere moments of computation EXP-148 (route A): $N=2$ and $N=3$ with $s=1,2$, and $N=14$ with $s=1$, for $m=1,\dots  ,6$. Every value equals $c_m\binom  {m-1}{s-1}(2)_{4m+s}/(N)_{4m+s}$ exactly, and the pure moments $\DOTSI \intop \ilimits@ P^m\,dg$ vanish in every cell. The entries with $s=2$ and $m=1$ are zero because $\binom  {0}{1}=0$.}}{34}{table.109}\protected@file@percent }
\newlabel{tab:mathieu}{{5}{34}{Exact values of $\int _{SU(N)}Q^sP^m\,dg$ for Long's pair, from the complex sphere moments of computation EXP-148 (route A): $N=2$ and $N=3$ with $s=1,2$, and $N=14$ with $s=1$, for $m=1,\dots ,6$. Every value equals $c_m\binom {m-1}{s-1}(2)_{4m+s}/(N)_{4m+s}$ exactly, and the pure moments $\int P^m\,dg$ vanish in every cell. The entries with $s=2$ and $m=1$ are zero because $\binom {0}{1}=0$}{table.109}{}}
